# Database Configuration
DATABASE_URL="postgresql://fluid:fluid@db:5432/fluid_calendar"

# NextAuth Configuration
# Use domain in production, localhost for development
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_ENABLE_SAAS_FEATURES=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Push / Push Notifications
# Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron job secret — must match what you pass when calling /api/push/reminders
CRON_SECRET=

# --- MCP server (src/mcp/server.ts, run with `npm run mcp`) ---
# Exposes calendar + tasks as MCP tools over Streamable HTTP for remote agents
# (e.g. Orka). Reuses DATABASE_URL above. See src/mcp/README.md.
FLUID_MCP_TOKEN=                              # required: Bearer token clients must send (openssl rand -hex 32)
FLUID_MCP_USER_EMAIL=                         # FluidCalendar user to act as (or set FLUID_MCP_USER_ID)
# FLUID_MCP_USER_ID=
FLUID_MCP_PORT=3837                           # listen port
FLUID_MCP_HOST=127.0.0.1                      # bind addr — keep local, front with a tunnel
FLUID_MCP_FEED_NAME=Orka                      # name of the LOCAL calendar feed events land in

# Obsidian vault over WebDAV (Notes tab) — read-only
OBSIDIAN_WEBDAV_URL=            # e.g. http://host:8585/
OBSIDIAN_WEBDAV_USERNAME=
OBSIDIAN_WEBDAV_PASSWORD=
NOTES_INBOX_DIR=               # vault folder for in-app dropped notes (default "/DreamDash Inbox")
OBSIDIAN_VAULT_NAME=           # vault name for "Open in Obsidian" deep-links (e.g. Main)

# --- Recordings ingest (Notes ▸ Recordings) ---
# Capture clients (Meetily, iPhone/Apple Watch Shortcuts) POST audio to
# /api/recordings authenticated with this key in the X-Api-Key header.
RECORDINGS_API_KEY=            # required to enable ingest (openssl rand -hex 32)
RECORDINGS_USER_EMAIL=         # user to attribute uploads to; omit on a single-user box
RECORDINGS_DIR=                # where audio files are stored; set to a PERSISTENT volume path
                              # (defaults to <cwd>/data/recordings — lost on redeploy)

# --- Project activity feed (Dashboard ▸ Projets) ---
# The claude-watch bridge POSTs a one-line summary of each agent turn to
# /api/ingest/project-activity, authenticated with this token in the
# `Authorization: Bearer <token>` header (X-Api-Key also accepted). Must match
# the bridge's DREAMDASH_TOKEN (claude-watch-bridge.service). Leave empty to
# disable the endpoint (returns 503).
PROJECT_INGEST_TOKEN=          # openssl rand -hex 24

# Auto transcription + summary on canardo (the home server). When a recording is
# ingested without a transcript/summary, it's transcribed via the local whisper
# server and summarized by a local Ollama model — nothing leaves the box.
WHISPER_URL=                  # faster-whisper server (default http://100.88.98.44:8787 = uguiso)
WHISPER_MODEL=                # default Systran/faster-whisper-base (uguiso has no GPU)
OLLAMA_URL=                   # local LLM (default http://100.88.98.44:11434 = uguiso)
OLLAMA_MODEL=                 # summary model (default qwen2.5:3b)

# --- AI search ("Ask AI" in the ⌘K palette) ---
# Answers a question using tasks, calendar, notes, recordings, projects and the
# Projets activity feed, then links the resources it consulted. Same local
# Ollama box as above; all defaults are fine.
#
# The context budget is small on purpose: the default box is CPU-only and
# evaluates a prompt at ~15 tok/s, so every 1k characters of context adds ~25s
# to the answer. Retrieval itself takes ~200ms. Raise the budgets only if
# ASK_MODEL points at faster (GPU) hardware.
ASK_MODEL=                    # defaults to OLLAMA_MODEL
ASK_TIMEOUT_MS=               # default 240000 (CPU inference is slow)
ASK_MAX_CONTEXT_CHARS=        # default 3800 — prompt-eval budget, see above
ASK_MAX_SOURCES=              # default 14 — resources fed to the model
ASK_MAX_PER_TYPE=             # default 5 — cap per source type, keeps one
                              #   noisy type (e.g. notes) from starving others
ASK_MAX_ANSWER_TOKENS=        # default 320 — generation cap
ASK_NOTES_READ_LIMIT=         # default 20 — Obsidian notes read per question

# --- Work sessions (Sessions tab) ---
# A recorded call + a lexicon + a written brief, compiled into a "mission" that
# Claude Code pulls over MCP. Transcription keeps timestamped segments, so an
# agent reads a cheap digest first and pulls verbatim minutes on demand rather
# than swallowing hours of transcript.
#
# NOTE: sessions deliberately target canardo (100.87.10.111), NOT the uguiso box
# the settings above point at. canardo has an RTX 3060; uguiso has 4 CPU cores,
# where a four-hour call takes longer to transcribe than it took to record.
# Trade-off: canardo's whisper API accepts `prompt` but not `hotwords`, so the
# lexicon reaches it as an initial prompt. Point SESSION_WHISPER_URL at
# http://100.88.98.44:8787 if you want hotwords more than you want speed.
SESSION_WHISPER_URL=          # default http://100.87.10.111:9093 (canardo, GPU)
SESSION_WHISPER_MODEL=        # default "qc" — canardo's Québécois turbo fine-tune
SESSION_LLM_URL=              # default http://100.87.10.111:11434 (canardo, GPU)
SESSION_LLM_MODEL=            # digest model (default qwen2.5:14b — fits the 12 GB card)
SESSION_LLM_TIMEOUT_MS=       # default 900000 (15 min)
SESSION_CHUNK_SEC=            # transcript chunk width for the table of contents (default 600)

# --- Mail (Email tab) ---
# Connect iCloud/Zoho/IMAP accounts in-app (Settings handled in the UI). Account
# passwords are encrypted at rest with a key derived from MAIL_SECRET, which
# falls back to NEXTAUTH_SECRET if unset. Set a dedicated value only if you plan
# to rotate NEXTAUTH_SECRET (otherwise saved mail passwords become unreadable).
MAIL_SECRET=
