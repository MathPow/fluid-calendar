// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectedAccount {
  id             String         @id @default(cuid())
  provider       String // "GOOGLE" | "OUTLOOK" | "CALDAV"
  email          String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  calendars      CalendarFeed[]
  // CalDAV specific fields
  caldavUrl      String? // Base URL for CalDAV server
  caldavUsername String? // Username for Basic Auth

  // User relationship
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  TaskProvider TaskProvider[]

  @@unique([userId, provider, email])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  role                 String                @default("user") // Possible values: "user", "admin"
  subscription         Subscription?
  accounts             Account[]
  sessions             Session[]
  calendars            CalendarFeed[]
  autoScheduleSettings AutoScheduleSettings?
  userSettings         UserSettings?
  calendarSettings     CalendarSettings?
  notificationSettings NotificationSettings?
  integrationSettings  IntegrationSettings?
  dataSettings         DataSettings?
  tasks                Task[]
  projects             Project[]
  connectedAccounts    ConnectedAccount[]
  tags                 Tag[]
  JobRecord            JobRecord[]
  taskProviders        TaskProvider[]
  TaskChange           TaskChange[]
  PasswordReset        PasswordReset[]
  pushSubscriptions    PushSubscription[]
  recordings           Recording[]
  mailAccounts         MailAccount[]
  voiceCommands        VoiceCommand[]
  workSessions         WorkSession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CalendarFeed {
  id                String            @id @default(uuid())
  name              String
  url               String? // Optional for local calendars
  type              String // "LOCAL", "GOOGLE", "OUTLOOK", "CALDAV"
  color             String? // Add back color field
  enabled           Boolean           @default(true)
  station           String? // "personal" | "work" | null — for the station filter
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastSync          DateTime?
  syncToken         String? // For incremental sync
  error             String?
  channelId         String? // Google Calendar webhook channel ID
  resourceId        String? // Google Calendar webhook resource ID
  channelExpiration DateTime? // When the webhook expires
  events            CalendarEvent[]
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  accountId         String?
  account           ConnectedAccount? @relation(fields: [accountId], references: [id])
  // CalDAV specific fields
  caldavPath        String? // Path to the specific calendar on the server
  ctag              String? // CalDAV collection tag for change detection

  @@index([accountId])
}

model CalendarEvent {
  id              String       @id @default(uuid())
  feedId          String
  feed            CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalEventId String? // External Calendar Event ID (Google, Outlook, etc.)
  title           String
  description     String?
  start           DateTime
  end             DateTime
  location        String?
  isRecurring     Boolean      @default(false)
  recurrenceRule  String?
  allDay          Boolean      @default(false)
  status          String?
  sequence        Int?
  created         DateTime?
  lastModified    DateTime?
  organizer       Json? // Stored as JSON { name?: string, email: string }
  attendees       Json? // Stored as JSON array of { name?: string, email: string, status?: string }
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // "Strong alarm": when true, this event should trigger a real device alarm
  // (via the iOS Shortcuts poll at /api/shortcuts/alarms) rather than a normal
  // push reminder. alarmMinutes is how long before `start` the alarm fires.
  // alarmArmedAt is a dedup ledger: null = not yet handed to the Shortcut; set =
  // already armed. It's reset to null whenever `start` or `strongAlarm` changes.
  strongAlarm  Boolean   @default(false)
  alarmMinutes Int       @default(30)
  alarmArmedAt DateTime?

  // New fields for hybrid approach
  isMaster         Boolean         @default(false) // True if this is a master event
  masterEventId    String? // Reference to the master event for instances
  masterEvent      CalendarEvent?  @relation("EventInstances", fields: [masterEventId], references: [id], onDelete: Cascade)
  instances        CalendarEvent[] @relation("EventInstances")
  recurringEventId String? // Google Calendar's recurring event ID

  @@index([feedId])
  @@index([start, end])
  @@index([externalEventId])
  @@index([masterEventId])
  @@index([recurringEventId])
}

model Project {
  id               String            @id @default(cuid())
  name             String
  description      String?
  color            String?
  status           String            @default("active") // enum: 'active', 'archived'
  tasks            Task[]
  taskListMappings TaskListMapping[]

  // External sync fields
  externalId     String?
  externalSource String?
  lastSyncedAt   DateTime?

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([externalId, externalSource])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String // enum: 'todo', 'in_progress', 'completed'

  // Time Management
  dueDate       DateTime?
  startDate     DateTime? // When the task becomes active
  duration      Int? // estimated duration in minutes
  priority      String? // enum: 'high', 'medium', 'low', 'none'
  energyLevel   String? // enum: 'high', 'medium', 'low'
  preferredTime String? // enum: 'morning', 'afternoon', 'evening'

  // Auto-scheduling
  isAutoScheduled Boolean   @default(false)
  scheduleLocked  Boolean   @default(false)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  scheduleScore   Float?
  lastScheduled   DateTime?
  postponedUntil  DateTime? // New field for postponing tasks

  // Organization
  tags Tag[]

  // Recurrence
  isRecurring       Boolean   @default(false)
  recurrenceRule    String?
  lastCompletedDate DateTime?
  completedAt       DateTime? // When the task was marked as completed

  // External Integration
  externalTaskId String?
  source         String?
  lastSyncedAt   DateTime?

  // Enhanced sync fields
  externalListId    String? // The external list/folder ID this task belongs to
  externalCreatedAt DateTime? // When the task was created in the external system
  externalUpdatedAt DateTime? // When the task was last updated in the external system
  syncStatus        String? // 'synced', 'pending', 'error', etc.
  syncError         String? // Error message if sync failed
  syncHash          String? // Hash of task data for detecting changes
  skipSync          Boolean   @default(false) // Flag to skip syncing this task

  // Change tracking relation
  changes TaskChange[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([startDate])
  @@index([priority])
  @@index([projectId])
  @@index([isRecurring])
  @@index([isAutoScheduled])
  @@index([scheduledStart, scheduledEnd])
  @@index([externalTaskId])
  @@index([source])
  @@index([postponedUntil])
  @@index([userId])
  @@index([externalTaskId, source])
  @@index([syncStatus])
  @@index([externalListId])
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String?
  tasks Task[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@unique([name, userId])
  @@index([name])
  @@index([userId])
}

model AutoScheduleSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Work Hours
  workDays      String @default("[]") // JSON string of numbers 0-6
  workHourStart Int // 0-23
  workHourEnd   Int // 0-23

  // Preferences
  selectedCalendars String @default("[]") // JSON string of calendar IDs
  bufferMinutes     Int    @default(15)

  // Energy Level Mappings
  highEnergyStart   Int? // 0-23
  highEnergyEnd     Int? // 0-23
  mediumEnergyStart Int? // 0-23
  mediumEnergyEnd   Int? // 0-23
  lowEnergyStart    Int? // 0-23
  lowEnergyEnd      Int? // 0-23

  // Project Settings
  groupByProject Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        String   @default("system") // "light", "dark", "system"
  defaultView  String   @default("week") // "day", "week", "month", "agenda"
  timeZone     String
  weekStartDay String   @default("sunday") // "monday", "sunday"
  timeFormat   String   @default("12h") // "12h", "24h"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CalendarSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCalendarId   String?
  workingHoursEnabled Boolean  @default(true)
  workingHoursStart   String   @default("09:00") // HH:mm format
  workingHoursEnd     String   @default("17:00") // HH:mm format
  workingHoursDays    String   @default("[1,2,3,4,5]") // JSON string of numbers 0-6
  defaultDuration     Int      @default(60) // minutes
  defaultColor        String   @default("#3b82f6")
  defaultReminder     Int      @default(30) // minutes
  refreshInterval     Int      @default(5) // minutes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model NotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications    Boolean  @default(true)
  dailyEmailEnabled     Boolean  @default(true) // Controls whether the user receives daily email updates
  eventInvites          Boolean  @default(true)
  eventUpdates          Boolean  @default(true)
  eventCancellations    Boolean  @default(true)
  eventReminders        Boolean  @default(true)
  defaultReminderTiming String   @default("[30]") // JSON string of minutes before event
  pushRemindersEnabled  Boolean  @default(true)
  pushReminderMinutes   Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model IntegrationSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleCalendarEnabled   Boolean  @default(true)
  googleCalendarAutoSync  Boolean  @default(true)
  googleCalendarInterval  Int      @default(5) // minutes
  outlookCalendarEnabled  Boolean  @default(true)
  outlookCalendarAutoSync Boolean  @default(true)
  outlookCalendarInterval Int      @default(5) // minutes
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model DataSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoBackup     Boolean  @default(true)
  backupInterval Int      @default(7) // days
  retainDataFor  Int      @default(365) // days
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model SystemSettings {
  id                  String   @id @default(cuid())
  googleClientId      String?
  googleClientSecret  String?
  outlookClientId     String?
  outlookClientSecret String?
  outlookTenantId     String?
  logLevel            String   @default("none") // none, debug, info, warn, error
  logRetention        Json? // Retention periods per log level
  logDestination      String   @default("db") // db, file, both
  publicSignup        Boolean  @default(false) // Whether public signup is enabled
  disableHomepage     Boolean  @default(false) // Whether to disable the homepage and redirect to login/calendar
  resendApiKey        String? // API key for Resend email service
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String // INFO, WARN, ERROR, DEBUG
  message   String   @db.Text
  metadata  Json? // For structured data
  source    String? // Component/service name
  expiresAt DateTime // For TTL-based cleanup

  @@index([timestamp, level])
  @@index([expiresAt])
  @@index([source, level])
}

model PendingWaitlist {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  referralCode         String? // Referral code used during signup
  verificationToken    String   @unique
  verificationExpiry   DateTime
  interestedInLifetime Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([verificationToken])
  @@index([email])
}

model Waitlist {
  id                        String    @id @default(cuid())
  email                     String    @unique
  name                      String?
  status                    String    @default("WAITING") // WAITING, INVITED, REGISTERED
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  invitedAt                 DateTime?
  registeredAt              DateTime?
  invitationToken           String?
  invitationExpiry          DateTime?
  referralCode              String    @unique
  referredBy                String?
  referralCount             Int       @default(0)
  priorityScore             Float     @default(0)
  lastVisitedAt             DateTime?
  notes                     String?
  lastPosition              Int? // Added to track position changes
  interestedInLifetime      Boolean   @default(false)
  queueNotificationsEnabled Boolean   @default(true) // Controls whether to send queue position notifications

  @@index([status])
  @@index([referredBy])
  @@index([priorityScore])
  @@index([referralCode])
}

model BetaSettings {
  id                           String  @id @default("default")
  maxActiveUsers               Int     @default(100)
  invitationValidDays          Int     @default(7)
  autoInviteEnabled            Boolean @default(false)
  autoInviteCount              Int     @default(10)
  autoInviteFrequency          String  @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  referralBoostAmount          Float   @default(1.0)
  maxReferralBoost             Float   @default(10.0)
  showQueuePosition            Boolean @default(true)
  showTotalWaitlist            Boolean @default(true)
  invitationEmailTemplate      String  @default("") @db.Text
  waitlistConfirmationTemplate String  @default("") @db.Text
  reminderEmailTemplate        String  @default("") @db.Text
}

// Job tracking models for BullMQ
model JobRecord {
  id          String    @id @default(cuid())
  queueName   String
  jobId       String
  name        String
  data        Json
  status      JobStatus @default(PENDING)
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([queueName, jobId])
  @@index([status])
  @@index([queueName])
  @@index([userId])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
}

// New models for task synchronization
model TaskProvider {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // 'outlook', 'google', etc.
  name             String
  enabled          Boolean           @default(true)
  syncEnabled      Boolean           @default(true)
  syncInterval     String            @default("hourly") // 'hourly', 'daily', 'manual'
  lastSyncedAt     DateTime?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  accountId        String? // References a ConnectedAccount
  account          ConnectedAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  defaultProjectId String? // Default project for tasks without a list mapping
  settings         Json? // Provider-specific settings
  mappings         TaskListMapping[]
  error            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  TaskChange       TaskChange[]

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model TaskListMapping {
  id               String       @id @default(cuid())
  providerId       String
  provider         TaskProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalListId   String // ID of the external task list
  externalListName String // Name of the external task list
  direction        String       @default("incoming") // 'incoming', 'outgoing', 'bidirectional'
  isDefault        Boolean      @default(false)
  syncEnabled      Boolean      @default(true)
  isAutoScheduled  Boolean      @default(true)
  lastSyncedAt     DateTime?
  syncStatus       String?
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  TaskChange       TaskChange[]

  @@unique([providerId, projectId])
  @@unique([providerId, externalListId])
  @@index([providerId])
  @@index([projectId])
  @@index([externalListId])
}

// New model for task change tracking
model TaskChange {
  id         String           @id @default(cuid())
  taskId     String? // ID of the task that changed
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  providerId String? // ID of the provider if this is related to a sync
  provider   TaskProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  mappingId  String? // ID of the mapping if this is related to a list sync
  mapping    TaskListMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  changeType String // 'CREATE', 'UPDATE', 'DELETE'
  changeData Json? // The actual changes, as a diff
  synced     Boolean          @default(false) // Whether this change has been synced
  timestamp  DateTime         @default(now())
  userId     String // User who made the change
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([taskId])
  @@index([providerId])
  @@index([mappingId])
  @@index([changeType])
  @@index([synced])
  @@index([timestamp])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum SubscriptionPlan {
  FREE
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  PAYMENT_PENDING
  PAYMENT_FAILED
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?            @unique
  stripePaymentIntentId String?            @unique // For one-time payments like lifetime access
  amount                Int? // Amount paid in cents
  discountApplied       Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([stripeCustomerId])
  @@index([stripePaymentIntentId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SentPushReminder {
  id              String   @id @default(cuid())
  userId          String
  eventId         String
  reminderMinutes Int
  sentAt          DateTime @default(now())

  @@unique([userId, eventId, reminderMinutes])
  @@index([userId])
  @@index([sentAt])
}

// Audio recordings synced in from external capture clients (Meetily on the Mac,
// Apple Watch / iPhone voice memos via Shortcuts). The client POSTs the audio
// file plus optional transcript/summary text to /api/recordings; the bytes live
// on disk under RECORDINGS_DIR and this row holds the metadata + text.
model Recording {
  id          String   @id @default(cuid())
  userId      String
  title       String
  source      String   @default("upload") // "meetily" | "watch" | "upload"
  fileName    String // original client filename, e.g. "standup.m4a"
  storagePath String // path on disk relative to RECORDINGS_DIR
  mimeType    String   @default("audio/mp4")
  sizeBytes   Int      @default(0)
  durationSec Int?
  transcript  String? // full transcript text (client-supplied or canardo-generated)
  summary     String? // short summary (client-supplied or canardo-generated)
  // Server-side transcription/summary pipeline (canardo: whisper + local LLM).
  status      String   @default("done") // "pending" | "processing" | "done" | "error"
  statusError String? // last pipeline error message, if status = "error"
  language    String? // transcript language detected by whisper, e.g. "fr" | "en"
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  // Work-session grouping. A multi-hour call is usually several audio files that
  // belong to one session; null for standalone recordings (watch memos, Meetily).
  sessionId   String?
  orderIndex  Int      @default(0) // playback/transcript order within the session
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  session  WorkSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  segments TranscriptSegment[]

  @@index([userId])
  @@index([recordedAt])
  @@index([status])
  @@index([sessionId, orderIndex])
}

// One timestamped chunk of a recording's transcript, as returned by whisper's
// `verbose_json` segments. Storing these (rather than only the flat text) is
// what makes deep retrieval possible: an agent reads the cheap digest + table of
// contents, then pulls only the minutes it actually needs, with citable
// timestamps. A GIN index on to_tsvector('french', text) backs search — added in
// the migration, since Prisma can't express a functional index.
model TranscriptSegment {
  id          String    @id @default(cuid())
  recordingId String
  idx         Int // 0-based position within the recording
  startSec    Float
  endSec      Float
  text        String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, idx])
  @@index([recordingId, startSec])
}

// A "work session": the audio of a call plus everything needed to turn it into
// directed agent work — a lexicon that sharpens transcription, a written brief
// saying what the agent should do with it, and the local filesystem paths it may
// touch. Compiled into a mission that Claude Code pulls over MCP.
model WorkSession {
  id     String @id @default(cuid())
  userId String
  title  String

  // --- Filled in before transcription ---
  // Proper nouns to get right: company names, project names, the speakers.
  // One term per line, optionally "term = context note". Fed to whisper as
  // `hotwords` + an initial `prompt`, so it must be set BEFORE compiling.
  lexicon String?
  // Forced transcription language (ISO-639-1). Skips whisper's autodetect, which
  // drifts on long bilingual calls. Null = autodetect.
  language String?
  // Whisper model override, e.g. "deepdml/faster-whisper-large-v3-turbo-ct2".
  model String?

  // --- Direction for the agent ---
  brief   String? // free-form: what we decided, what Claude should do with it
  targets Json? // [{ path, kind: "repo"|"doc", note }] — local paths on the user's machine

  // --- Generated by the compile step ---
  digest String? // decisions / changes / actions, each tagged with a timestamp
  toc    String? // table of contents: ~10-min chunks with 2-3 line summaries

  status      String    @default("draft") // "draft" | "processing" | "ready" | "error"
  statusError String?
  compiledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordings Recording[]

  @@index([userId, createdAt])
  @@index([status])
}

// A connected mail account (iCloud, Zoho, or generic IMAP). Messages are NOT
// stored — they're fetched live over IMAP on demand. Only the connection
// config lives here; the password is encrypted at rest (see src/lib/mail/crypto).
model MailAccount {
  id          String   @id @default(cuid())
  userId      String
  provider    String // "icloud" | "zoho" | "imap"
  displayName String? // optional label shown in the UI
  email       String // the address / login
  imapHost    String
  imapPort    Int      @default(993)
  smtpHost    String
  smtpPort    Int      @default(465)
  username    String // usually == email
  passwordEnc String // AES-256-GCM encrypted app-specific password
  station     String? // "personal" | "work" | null — for the station filter
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

// Audit log of voice/text commands sent to /api/voice and what they did, so the
// action is reversible (delete the created task/event) and followable. The audio
// itself stays ephemeral — only the transcript + outcome are kept.
model VoiceCommand {
  id         String    @id @default(cuid())
  userId     String
  transcript String
  action     String // "create_task" | "create_event" | "create_note" | "unknown"
  ok         Boolean   @default(false)
  message    String?
  targetType String? // "task" | "event"
  targetId   String? // id of the created row, for revert
  reverted   Boolean   @default(false)
  revertedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// A code workspace/repo that Claude operates in via the SSH web terminal (ttyd).
// Keyed by `slug` = folder basename, matching the ttyd launcher project id and
// the claude-watch bridge's folderName. DISTINCT from the task-management
// `Project` model above — this one tracks what the agent *did* per repo, fed by
// the claude-watch bridge (Stop hook → Canardo summary → POST). Global (not
// user-scoped): repos are shared, and the dashboard pages already require a session.
model AgentProject {
  id             String          @id @default(cuid())
  slug           String          @unique // folder basename, e.g. "dreamdash", "ttyd"
  name           String
  path           String? // absolute path on the box, if known
  lastActivityAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activities     AgentActivity[]

  @@index([lastActivityAt])
}

// One turn of agent work, summarized. Appended each time Claude finishes a turn
// in a repo's web terminal.
model AgentActivity {
  id        String       @id @default(cuid())
  projectId String
  project   AgentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary   String // short markdown summary of what the agent did
  agent     String? // e.g. "claude"
  source    String? // e.g. "ttyd-web", "stop-hook"
  createdAt DateTime     @default(now())

  @@index([projectId])
  @@index([createdAt])
}
